---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllProofs, CATEGORY_LABELS } from '../lib/proofs';

const proofs = await getAllProofs();
---

<BaseLayout title="Timeline — Hypotenuse" description="Every proof in the archive, placed on a timeline from Euclid to the present.">
  <div class="timeline-hero">
    <p class="eyebrow">c. 300 BCE — today</p>
    <h1>Three thousand years of the same idea.</h1>
  </div>

  <div class="timeline-list">
    <div class="timeline-axis" aria-hidden="true"></div>
    {proofs.map((proof) => (
      <a href={`/proofs/${proof.id}`} class="timeline-row">
        <span class="timeline-date font-mono">{proof.data.yearDisplay}</span>
        <span class="timeline-dot-col"><span class="timeline-dot" aria-hidden="true"></span></span>
        <span class="timeline-content">
          <span class="timeline-title">{proof.data.title}</span>
          <span class="timeline-attribution">{proof.data.attribution} · {CATEGORY_LABELS[proof.data.category]}</span>
        </span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .timeline-hero {
    padding: 56px 56px 40px 56px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .timeline-hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 52px;
    letter-spacing: -0.015em;
  }

  .timeline-list {
    position: relative;
    margin: 0 56px 64px 56px;
  }
  .timeline-axis {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 124px;
    width: 1px;
    background: var(--line);
  }
  .timeline-row {
    position: relative;
    display: grid;
    grid-template-columns: 108px 32px 1fr;
    align-items: center;
    gap: 0;
    padding: 22px 0;
    border-top: 1px solid var(--hair);
  }
  .timeline-row:last-child {
    border-bottom: 1px solid var(--hair);
  }
  .timeline-date {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
    padding-right: 14px;
    white-space: nowrap;
    color: var(--ink-2);
  }
  .timeline-dot-col {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .timeline-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink-2);
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }
  .timeline-row:hover .timeline-dot,
  .timeline-row:focus-visible .timeline-dot {
    background: var(--sq-c);
    transform: scale(1.35);
  }
  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 20px;
    min-width: 0;
  }
  .timeline-title {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink);
    transition: color 0.2s ease;
  }
  .timeline-row:hover .timeline-title,
  .timeline-row:focus-visible .timeline-title {
    color: var(--sq-c);
  }
  .timeline-attribution {
    font-size: 12.5px;
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .timeline-hero {
      padding: 40px 20px 24px 20px;
    }
    .timeline-hero h1 {
      font-size: 38px;
    }
    .timeline-list {
      margin: 0 20px 40px 20px;
    }
    .timeline-axis {
      left: 72px;
    }
    .timeline-row {
      grid-template-columns: 60px 24px 1fr;
      padding: 18px 0;
    }
    .timeline-date {
      padding-right: 10px;
      font-size: 9.5px;
      white-space: normal;
    }
    .timeline-content {
      padding-left: 12px;
    }
    .timeline-title {
      font-size: 18px;
    }
  }
</style>
