---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShuffleButton from '../components/ShuffleButton.astro';
import SquaresFigure from '../components/figures/SquaresFigure.astro';
import { rightTriangleLayout, centroid, add } from '../lib/geometry';

const layout = rightTriangleLayout(120, 160);
const labelA = add(centroid(layout.squareRP), { x: 0, y: 8 });
const labelB = add(centroid(layout.squareRQ), { x: 0, y: 8 });
const labelC = add(centroid(layout.squarePQ), { x: 0, y: 8 });
---

<BaseLayout title="Hypotenuse — 300+ proofs of the Pythagorean theorem" description="Every proof is the same three squares, rearranged. Browse an open archive of proofs of a² + b² = c², from Euclid to Einstein.">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">One of 300+ proofs of a² + b² = c²</p>
      <h1>The same truth,<br />proved <em>three hundred</em> ways.</h1>
      <p class="hero-copy">Every proof is the same three squares, rearranged. Some take a page. One takes a single sentence.</p>
      <div class="hero-actions">
        <ShuffleButton />
        <a href="/proofs" class="browse-link font-mono">or browse the index</a>
      </div>
    </div>

    <div class="hero-figure" aria-hidden="true">
      <svg width="560" height="590" viewBox="-160 -310 470 500" style="overflow:visible">
        <g class="hero-figure-group">
          <SquaresFigure layout={layout} />
          <path
            d={`M ${layout.R.x + 18},${layout.R.y} L ${layout.R.x + 18},${layout.R.y - 18} L ${layout.R.x},${layout.R.y - 18}`}
            fill="none"
            stroke="var(--ink)"
            stroke-width="1.4"
            opacity="0.55"
          ></path>
          <text x={labelA.x} y={labelA.y} text-anchor="middle" font-family="Instrument Serif, serif" font-size="26" font-style="italic" fill="var(--ink)">a²</text>
          <text x={labelB.x} y={labelB.y} text-anchor="middle" font-family="Instrument Serif, serif" font-size="26" font-style="italic" fill="var(--ink)">b²</text>
          <text x={labelC.x} y={labelC.y} text-anchor="middle" font-family="Instrument Serif, serif" font-size="26" font-style="italic" fill="var(--ink)">c²</text>
        </g>
      </svg>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
    padding: 48px 56px 40px 56px;
    min-height: calc(100vh - 86px - 65px);
  }
  .hero-text {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }
  .hero-text h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 86px;
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .hero-text h1 em {
    font-style: italic;
    color: var(--sq-c);
  }
  .hero-copy {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 400px;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }
  .browse-link {
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .browse-link:hover {
    color: var(--sq-c);
  }
  .hero-figure {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-figure-group {
    transition: transform 0.6s cubic-bezier(0.3, 1.15, 0.35, 1);
    transform-origin: 60px -60px;
  }
  .hero-figure:hover .hero-figure-group {
    transform: rotate(8deg);
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 40px 24px;
      min-height: auto;
    }
    .hero-text h1 {
      font-size: 56px;
    }
    .hero-figure svg {
      width: 100%;
      height: auto;
    }
  }
</style>
