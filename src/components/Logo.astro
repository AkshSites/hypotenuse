---
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg width={size} height={size} viewBox="-1 -1 22 22" style="overflow:visible" aria-hidden="true" focusable="false">
  <polygon points="0,20 0,0 20,20" fill="none" stroke="currentColor" stroke-width="1.6"></polygon>
  <rect x="0" y="20" width="20" height="6" fill="var(--sq-b)"></rect>
  <rect x="-6" y="0" width="6" height="20" fill="var(--sq-a)"></rect>
</svg>
