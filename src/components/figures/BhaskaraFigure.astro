---
import FigurePanel from './FigurePanel.astro';
import { pt, rotate, polygon } from '../../lib/geometry';

interface Props {
  title: string;
}
const { title } = Astro.props;

const a = 120;
const b = 160;
const c = 200;
const center = pt(c / 2, c / 2);
const H = [pt(0, 0), pt(c, 0), pt(c, c), pt(0, c)];
const V0 = pt((a * a) / c, (a * b) / c);
const quarterTurn = Math.PI / 2;
const V = [V0, rotate(V0, -quarterTurn, center), rotate(V0, -2 * quarterTurn, center), rotate(V0, -3 * quarterTurn, center)];

const triangles = [
  [H[0], H[1], V[0]],
  [H[1], H[2], V[1]],
  [H[2], H[3], V[2]],
  [H[3], H[0], V[3]],
];
---

<FigurePanel title={title} viewBox="-30 -30 260 260" width={460} height={460}>
  <polygon points={polygon(H)} fill="var(--sq-c)" data-figure-id="sqC" data-kind="fill" style="--base-opacity:0.45"></polygon>
  {triangles.map((tri, i) => (
    <polygon
      points={polygon(tri)}
      fill="var(--paper)"
      stroke="var(--ink)"
      stroke-width="1.4"
      data-figure-id={`tri${i + 1}`}
      data-kind="fill"
      style="--base-opacity:0.9"
    ></polygon>
  ))}
  <polygon points={polygon(V)} fill="var(--ink)" data-figure-id="innerSquare" data-kind="fill" style="--base-opacity:0.16; --lit-opacity:0.5"></polygon>
  <polygon points={polygon(H)} fill="none" stroke="var(--ink)" stroke-width="1.6"></polygon>
</FigurePanel>
