---
import FigurePanel from './FigurePanel.astro';
import { rightTriangleLayout, footOfAltitude, polygon, path } from '../../lib/geometry';

interface Props {
  title: string;
}
const { title } = Astro.props;

const layout = rightTriangleLayout(120, 160);
const { R: A, P: B, Q: C } = layout;
const D = footOfAltitude(A, B, C);
const triABD = [A, B, D];
const triACD = [A, C, D];
const triWhole = [A, B, C];
---

<FigurePanel title={title} viewBox="-40 -160 280 300" width={420} height={330}>
  <polygon points={polygon(triWhole)} fill="var(--sq-c)" stroke="var(--ink)" stroke-width="1.6" data-figure-id="triWhole" data-kind="fill" style="--base-opacity:0.14; --lit-opacity:0.4"></polygon>

  <polygon points={polygon(triABD)} fill="var(--sq-a)" stroke="var(--ink)" stroke-width="1.2" data-figure-id="triABD" data-kind="fill" style="--base-opacity:0.55; --lit-opacity:0.9"></polygon>
  <polygon points={polygon(triACD)} fill="var(--sq-b)" stroke="var(--ink)" stroke-width="1.2" data-figure-id="triACD" data-kind="fill" style="--base-opacity:0.55; --lit-opacity:0.9"></polygon>

  <path d={path([A, D])} stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="5 5" data-figure-id="altitude" data-kind="line" style="--base-opacity:0.65"></path>

  <circle cx={A.x} cy={A.y} r="3" fill="var(--ink)"></circle>
  <circle cx={B.x} cy={B.y} r="3" fill="var(--ink)"></circle>
  <circle cx={C.x} cy={C.y} r="3" fill="var(--ink)"></circle>
  <circle cx={D.x} cy={D.y} r="3" fill="var(--ink)"></circle>
  <text x={A.x - 6} y={A.y - 12} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">A</text>
  <text x={B.x - 14} y={B.y + 4} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">B</text>
  <text x={C.x + 14} y={C.y + 4} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">C</text>
  <text x={D.x} y={D.y + 20} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink)">D</text>
</FigurePanel>
