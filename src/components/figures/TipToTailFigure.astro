---
import FigurePanel from './FigurePanel.astro';
import { rightTriangleLayout, add, scale, normalize, sub, polygon, path } from '../../lib/geometry';

interface Props {
  title: string;
}
const { title } = Astro.props;

const layout = rightTriangleLayout(120, 160);
const { R: A, P: B, Q: C } = layout;

// u runs B→A, v runs A→C — tip to tail, meeting at the right angle A.
// u+v, added the ordinary way, is exactly the vector B→C: the hypotenuse.
const dirAB = normalize(sub(B, A));
const dirAC = normalize(sub(C, A));
const markSize = 14;
const m1 = add(A, scale(dirAB, markSize));
const m2 = add(m1, scale(dirAC, markSize));
const m3 = add(A, scale(dirAC, markSize));
---

<FigurePanel title={title} viewBox="-40 -160 280 300" width={420} height={330}>
  <polygon points={polygon([A, B, C])} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.6" data-figure-id="triOutline" data-kind="fill" style="--base-opacity:1"></polygon>

  <path d={path([m1, m2, m3])} fill="none" stroke="var(--ink)" stroke-width="1.6" data-figure-id="rightAngleMark" data-kind="line" style="--base-opacity:0.5; --stroke-lit:2.6"></path>

  <path d={path([B, A])} stroke="var(--sq-a)" stroke-width="2.2" marker-end="url(#arrow-u)" data-figure-id="vecU" data-kind="line" style="--base-opacity:0; --stroke-base:2.2; --stroke-lit:3.2"></path>
  <path d={path([A, C])} stroke="var(--sq-b)" stroke-width="2.2" marker-end="url(#arrow-v)" data-figure-id="vecV" data-kind="line" style="--base-opacity:0; --stroke-base:2.2; --stroke-lit:3.2"></path>
  <path d={path([B, C])} stroke="var(--sq-c)" stroke-width="2.2" marker-end="url(#arrow-sum)" data-figure-id="vecSum" data-kind="line" style="--base-opacity:0; --stroke-base:2.2; --stroke-lit:3.2"></path>

  <defs>
    <marker id="arrow-u" markerWidth="9" markerHeight="9" refX="4.5" refY="4.5" orient="auto">
      <path d="M0,0 L9,4.5 L0,9 Z" fill="var(--sq-a)"></path>
    </marker>
    <marker id="arrow-v" markerWidth="9" markerHeight="9" refX="4.5" refY="4.5" orient="auto">
      <path d="M0,0 L9,4.5 L0,9 Z" fill="var(--sq-b)"></path>
    </marker>
    <marker id="arrow-sum" markerWidth="9" markerHeight="9" refX="4.5" refY="4.5" orient="auto">
      <path d="M0,0 L9,4.5 L0,9 Z" fill="var(--sq-c)"></path>
    </marker>
  </defs>

  <circle cx={A.x} cy={A.y} r="3" fill="var(--ink)"></circle>
  <circle cx={B.x} cy={B.y} r="3" fill="var(--ink)"></circle>
  <circle cx={C.x} cy={C.y} r="3" fill="var(--ink)"></circle>
  <text x={A.x - 12} y={A.y + 18} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">A</text>
  <text x={B.x - 14} y={B.y + 4} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">B</text>
  <text x={C.x + 14} y={C.y + 4} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">C</text>

  <text x={(A.x + B.x) / 2 - 16} y={(A.y + B.y) / 2} text-anchor="middle" font-family="Instrument Serif, serif" font-size="16" font-style="italic" fill="var(--sq-a)">u</text>
  <text x={(A.x + C.x) / 2} y={(A.y + C.y) / 2 - 10} text-anchor="middle" font-family="Instrument Serif, serif" font-size="16" font-style="italic" fill="var(--sq-b)">v</text>
</FigurePanel>
