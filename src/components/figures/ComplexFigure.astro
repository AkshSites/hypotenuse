---
import FigurePanel from './FigurePanel.astro';
import { pt, path } from '../../lib/geometry';

interface Props {
  title: string;
}
const { title } = Astro.props;

// z = a + bi, plotted with Im pointing up (negative y in SVG space).
const a = 120;
const b = 90;
const O = pt(0, 0);
const elbow = pt(a, 0);
const Z = pt(a, -b);
const Zc = pt(a, b);

const axisReach = 40;
const markSize = 12;
const mark = [pt(elbow.x - markSize, elbow.y), pt(elbow.x - markSize, elbow.y - markSize), pt(elbow.x, elbow.y - markSize)];
---

<FigurePanel title={title} viewBox="-50 -140 240 280" width={420} height={490}>
  <path d={path([pt(-axisReach, 0), pt(a + axisReach, 0)])} stroke="var(--ink-2)" stroke-width="1" opacity="0.4"></path>
  <path d={path([pt(0, -b - axisReach), pt(0, b + axisReach)])} stroke="var(--ink-2)" stroke-width="1" opacity="0.4"></path>
  <text x={a + axisReach + 6} y="4" font-family="JetBrains Mono, monospace" font-size="12" fill="var(--ink-2)">Re</text>
  <text x="-8" y={-b - axisReach - 6} font-family="JetBrains Mono, monospace" font-size="12" fill="var(--ink-2)">Im</text>

  <path d={path(mark)} fill="none" stroke="var(--ink)" stroke-width="1.4" opacity="0.5"></path>

  <path d={path([O, elbow])} stroke="var(--sq-a)" stroke-width="2.2" data-figure-id="reSeg" data-kind="line" style="--base-opacity:0; --stroke-base:2.2; --stroke-lit:3.6"></path>
  <path d={path([elbow, Z])} stroke="var(--sq-b)" stroke-width="2.2" data-figure-id="imSeg" data-kind="line" style="--base-opacity:0; --stroke-base:2.2; --stroke-lit:3.6"></path>
  <path d={path([O, Z])} stroke="var(--sq-c)" stroke-width="2.2" data-figure-id="modLine" data-kind="line" style="--base-opacity:0; --stroke-base:2.2; --stroke-lit:3.6"></path>

  <path d={path([O, Zc])} stroke="var(--sq-c)" stroke-width="1.6" stroke-dasharray="5 4" data-figure-id="zConjPoint" data-kind="line" style="--base-opacity:0; --stroke-base:1.6; --stroke-lit:2.6"></path>
  <path d={path([Z, Zc])} stroke="var(--ink-2)" stroke-width="1.4" stroke-dasharray="3 4" data-figure-id="zConjPoint" data-kind="line" style="--base-opacity:0; --stroke-base:1.4; --stroke-lit:2.2"></path>
  <circle cx={Zc.x} cy={Zc.y} r="4" fill="var(--ink-2)" data-figure-id="zConjPoint" data-kind="fill" style="--base-opacity:0.55"></circle>

  <circle cx={O.x} cy={O.y} r="3" fill="var(--ink)"></circle>
  <circle cx={Z.x} cy={Z.y} r="4.2" fill="var(--ink)" data-figure-id="zPoint" data-kind="fill" style="--base-opacity:0.8"></circle>

  <text x={O.x - 12} y={O.y + 18} text-anchor="middle" font-family="Instrument Serif, serif" font-size="16" fill="var(--ink)">O</text>
  <text x={Z.x + 14} y={Z.y - 8} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink)">z = a + bi</text>
  <text x={Zc.x + 20} y={Zc.y + 6} text-anchor="middle" font-family="Instrument Serif, serif" font-size="16" fill="var(--ink-2)">z̄ = a − bi</text>

  <text x={(O.x + elbow.x) / 2} y={O.y + 20} text-anchor="middle" font-family="Instrument Serif, serif" font-size="16" font-style="italic" fill="var(--sq-a)">a</text>
  <text x={elbow.x + 18} y={(elbow.y + Z.y) / 2} text-anchor="middle" font-family="Instrument Serif, serif" font-size="16" font-style="italic" fill="var(--sq-b)">bi</text>
  <text x={(O.x + Z.x) / 2 - 18} y={(O.y + Z.y) / 2 - 6} text-anchor="middle" font-family="Instrument Serif, serif" font-size="16" font-style="italic" fill="var(--sq-c)">c</text>
</FigurePanel>
