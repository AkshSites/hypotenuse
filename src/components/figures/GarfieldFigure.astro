---
import FigurePanel from './FigurePanel.astro';
import { pt, polygon, path } from '../../lib/geometry';

interface Props {
  title: string;
}
const { title } = Astro.props;

const legA = 120;
const legB = 160;

const O = pt(0, 0);
const B = pt(legB, 0);
const T = pt(0, -(legA + legB));
const Q = pt(legA, -(legA + legB));
const M = pt(0, -legA);

const triOne = [O, B, M];
const triTwo = [M, T, Q];
const triFill = [M, B, Q];
const trapezoid = [O, B, Q, T];
---

<FigurePanel title={title} viewBox="-70 -330 330 370" width={420} height={470}>
  <polygon points={polygon(trapezoid)} fill="none" stroke="var(--ink)" stroke-width="1.6" data-figure-id="trapezoid" data-kind="line" style="--base-opacity:0.9"></polygon>

  <polygon points={polygon(triOne)} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.3" data-figure-id="triAB1" data-kind="fill" style="--base-opacity:0.55; --lit-opacity:1"></polygon>
  <polygon points={polygon(triTwo)} fill="var(--paper)" stroke="var(--ink)" stroke-width="1.3" data-figure-id="triAB2" data-kind="fill" style="--base-opacity:0.55; --lit-opacity:1"></polygon>
  <polygon points={polygon(triFill)} fill="var(--sq-c)" stroke="var(--ink)" stroke-width="1.3" data-figure-id="triC" data-kind="fill" style="--base-opacity:0.35; --lit-opacity:0.85"></polygon>

  <path d={path([M, B])} stroke="var(--ink)" stroke-width="1.2" data-figure-id="triC" data-kind="line" style="--base-opacity:0"></path>
  <path d={path([M, Q])} stroke="var(--ink)" stroke-width="1.2" data-figure-id="triC" data-kind="line" style="--base-opacity:0"></path>

  <circle cx={M.x} cy={M.y} r="3" fill="var(--ink)"></circle>
  <text x={O.x - 16} y={O.y + 6} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">O</text>
  <text x={B.x + 14} y={B.y + 6} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">B</text>
  <text x={T.x - 16} y={T.y - 6} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">T</text>
  <text x={Q.x + 14} y={Q.y - 6} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">Q</text>
  <text x={M.x - 16} y={M.y + 4} text-anchor="middle" font-family="Instrument Serif, serif" font-size="18" fill="var(--ink)">M</text>

  <text x={(O.x + B.x) / 2} y={O.y + 22} text-anchor="middle" font-family="Instrument Serif, serif" font-size="15" font-style="italic" fill="var(--ink-2)">b</text>
  <text x={(T.x + Q.x) / 2} y={T.y - 12} text-anchor="middle" font-family="Instrument Serif, serif" font-size="15" font-style="italic" fill="var(--ink-2)">a</text>
</FigurePanel>
