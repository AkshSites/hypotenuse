---
import FigurePanel from './FigurePanel.astro';
import SquaresFigure from './SquaresFigure.astro';
import { rightTriangleLayout, apexOnSegment, polygon, path } from '../../lib/geometry';

interface Props {
  title: string;
}
const { title } = Astro.props;

const layout = rightTriangleLayout(120, 160);
const { R: C, squarePQ } = layout;

// G, H: the corners of the two leg-squares adjacent to C — the two sides of
// the 90° gap between them.
const G = layout.squareRP[2];
const H = layout.squareRQ[2];
const triGap = [C, G, H];

// The far edge of the hypotenuse square, and a second congruent triangle
// erected outward on it, the same way the leg-squares' gap was filled.
const A3 = squarePQ[2];
const B3 = squarePQ[3];
const S = apexOnSegment(A3, B3, 120, 160, false);
const triFar = [A3, S, B3];
---

<FigurePanel title={title} viewBox="-160 -340 480 540" width={480} height={540}>
  <SquaresFigure layout={layout} ids={{ a: 'sqA', b: 'sqB', c: 'sqC', triangle: 'triABC' }} labels={{ R: 'C', P: 'A', Q: 'B' }} />

  <polygon points={polygon(triGap)} fill="var(--ink)" stroke="var(--ink)" stroke-width="1.3" data-figure-id="triGap" data-kind="fill" style="--base-opacity:0; --lit-opacity:0.75"></polygon>
  <path d={path([G, H])} stroke="var(--ink)" stroke-width="1.2" data-figure-id="triGap" data-kind="line" style="--base-opacity:0"></path>

  <polygon points={polygon(triFar)} fill="var(--sq-c)" stroke="var(--ink)" stroke-width="1.3" data-figure-id="triFar" data-kind="fill" style="--base-opacity:0; --lit-opacity:0.55"></polygon>
  <path d={path([A3, S])} stroke="var(--ink)" stroke-width="1.2" data-figure-id="triFar" data-kind="line" style="--base-opacity:0"></path>
  <path d={path([S, B3])} stroke="var(--ink)" stroke-width="1.2" data-figure-id="triFar" data-kind="line" style="--base-opacity:0"></path>

  <circle cx={G.x} cy={G.y} r="3" fill="var(--ink)"></circle>
  <circle cx={H.x} cy={H.y} r="3" fill="var(--ink)"></circle>
  <text x={G.x - 16} y={G.y + 4} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink-2)">G</text>
  <text x={H.x - 4} y={H.y + 20} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink-2)">H</text>
  <text x={S.x + 4} y={S.y - 12} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink-2)">S</text>
</FigurePanel>
