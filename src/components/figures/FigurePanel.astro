---
import DiagramLegend from '../DiagramLegend.astro';

interface Props {
  title: string;
  viewBox: string;
  width?: number;
  height?: number;
}
const { title, viewBox, width = 500, height = 520 } = Astro.props;
---

<div class="figure-panel">
  <div class="figure-frame" data-proof-figure data-active="false">
    <svg width={width} height={height} viewBox={viewBox} style="overflow:visible" role="img" aria-label={`Diagram: ${title}`}>
      <slot />
    </svg>
  </div>
  <DiagramLegend />
</div>

<style>
  .figure-panel {
    position: sticky;
    top: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
    background: var(--paper-2);
    padding: 36px 24px 26px 24px;
    border-radius: 2px;
  }
  .figure-frame :global([data-figure-id]) {
    opacity: var(--base-opacity, 1);
    transition:
      opacity 0.3s ease,
      filter 0.3s ease,
      stroke-width 0.3s ease;
  }
  .figure-frame[data-active='true'] :global([data-figure-id]:not(.is-lit)) {
    opacity: calc(var(--base-opacity, 1) * 0.28);
  }
  .figure-frame :global([data-figure-id].is-lit) {
    opacity: var(--lit-opacity, 1);
    filter: brightness(1.12);
  }
  .figure-frame :global([data-figure-id][data-kind='line']) {
    stroke-width: var(--stroke-base, 1.4);
  }
  .figure-frame :global([data-figure-id][data-kind='line'].is-lit) {
    stroke-width: var(--stroke-lit, 3);
  }

  @media (max-width: 980px) {
    .figure-panel {
      position: static;
    }
  }
</style>
