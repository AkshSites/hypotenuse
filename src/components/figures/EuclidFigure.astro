---
import FigurePanel from './FigurePanel.astro';
import SquaresFigure from './SquaresFigure.astro';
import { rightTriangleLayout, footOfAltitude, add, scale, polygon, path } from '../../lib/geometry';

interface Props {
  title: string;
}
const { title } = Astro.props;

const layout = rightTriangleLayout(120, 160);
const { R: A, P: B, Q: C, squareRP, squareRQ, squarePQ, hypOutward, hyp } = layout;

const D = squarePQ[2]; // corner of the BC-square adjacent to B
const E = squarePQ[3]; // corner of the BC-square adjacent to C
const F = squareRP[3]; // corner of the AB-square adjacent to B
const G = squareRQ[2]; // corner of the AC-square adjacent to C
const foot = footOfAltitude(A, B, C);
const L = add(foot, scale(hypOutward, hyp));

const rectBDLF = [B, D, L, foot];
const rectFLE_C = [foot, L, E, C];
const triABD = [A, B, D];
const triFBC = [F, B, C];
const triACE = [A, C, E];
const triGCB = [G, C, B];
---

<FigurePanel title={title} viewBox="-150 -310 470 500" width={500} height={520}>
  <polygon points={polygon(rectBDLF)} fill="var(--sq-a)" data-figure-id="rectP" data-kind="fill" style="--base-opacity:0; --lit-opacity:0.85"></polygon>
  <polygon points={polygon(rectFLE_C)} fill="var(--sq-b)" data-figure-id="rectQ" data-kind="fill" style="--base-opacity:0; --lit-opacity:0.85"></polygon>
  <polygon points={polygon(triABD)} fill="var(--ink)" data-figure-id="triABD" data-kind="fill" style="--base-opacity:0; --lit-opacity:0.8"></polygon>
  <polygon points={polygon(triFBC)} fill="var(--ink)" data-figure-id="triFBC" data-kind="fill" style="--base-opacity:0; --lit-opacity:0.8"></polygon>
  <polygon points={polygon(triACE)} fill="var(--ink)" data-figure-id="triACE" data-kind="fill" style="--base-opacity:0; --lit-opacity:0.8"></polygon>
  <polygon points={polygon(triGCB)} fill="var(--ink)" data-figure-id="triGCB" data-kind="fill" style="--base-opacity:0; --lit-opacity:0.8"></polygon>

  <SquaresFigure layout={layout} labels={{ R: 'A', P: 'B', Q: 'C' }} />

  <path d={path([A, foot, L])} fill="none" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="5 5" data-figure-id="altitude" data-kind="line" style="--base-opacity:0"></path>
  <path d={path([B, D])} stroke="var(--ink)" stroke-width="1.1" data-figure-id="triABD" data-kind="line" style="--base-opacity:0"></path>
  <path d={path([F, C])} stroke="var(--ink)" stroke-width="1.1" data-figure-id="triFBC" data-kind="line" style="--base-opacity:0"></path>
  <path d={path([A, E])} stroke="var(--ink)" stroke-width="1.1" data-figure-id="triACE" data-kind="line" style="--base-opacity:0"></path>
  <path d={path([G, B])} stroke="var(--ink)" stroke-width="1.1" data-figure-id="triGCB" data-kind="line" style="--base-opacity:0"></path>

  <circle cx={A.x} cy={A.y} r="3" fill="var(--ink)"></circle>
  <text x={A.x - 6} y={A.y - 12} text-anchor="middle" font-family="Instrument Serif, serif" font-size="19" fill="var(--ink)">A</text>
  <text x={B.x - 14} y={B.y + 4} text-anchor="middle" font-family="Instrument Serif, serif" font-size="19" fill="var(--ink)">B</text>
  <text x={C.x + 14} y={C.y + 4} text-anchor="middle" font-family="Instrument Serif, serif" font-size="19" fill="var(--ink)">C</text>
  <text x={D.x - 4} y={D.y - 10} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink-2)">D</text>
  <text x={E.x + 12} y={E.y - 2} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink-2)">E</text>
  <text x={F.x - 12} y={F.y + 2} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink-2)">F</text>
  <text x={G.x + 4} y={G.y + 16} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink-2)">G</text>
  <text x={L.x + 14} y={L.y + 4} text-anchor="middle" font-family="Instrument Serif, serif" font-size="17" fill="var(--ink-2)">L</text>
</FigurePanel>
